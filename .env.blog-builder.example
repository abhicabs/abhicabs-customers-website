# ── Environment Variables ─────────────────────────────────────────────────────
# Copy these into your .env or .env.local file

# Backend API base URL
VITE_API_BASE_URL=https://api.abhicabs24x7.com/api/v1

# Cloudinary — for image uploads inside blog posts
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
# Optional. Leave unset to serve the site's own images from public/images (default).
# Set to true ONLY after uploading them with `npm run images:upload`; then every
# /images/… path is served from Cloudinary (folder "abhicabs") instead.
# VITE_CLOUDINARY_SERVE_SITE_IMAGES=true

# GitHub publishing (blogs.js / redirects.js) is done by the BACKEND now.
# Do NOT set VITE_GH_TOKEN here: every VITE_ variable ends up in the public JavaScript.
# Set GH_TOKEN (and optionally GH_REPO / GH_BRANCH) in the backend's environment instead.
