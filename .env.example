# ── Cloudinary (images) ──────────────────────────────────────────────
# Public — used at build time to point every /images/<file> at Cloudinary.
# Leave empty to keep serving images from /public/images.
VITE_CLOUDINARY_CLOUD_NAME=

# Secret — only needed on your machine to run `npm run images:upload`.
# Never commit these; never add them to Netlify.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
